<div class="layout">
 <div class="ds-root">
  <section class="ds-left">
   <div class="ds-brand">✦ DAILY SPARK</div>
   <div class="ds-date-area">
    <div class="ds-weekday">{{ display_day | upcase }}</div>
    <div class="ds-date-line">
     <strong class="ds-day-number">{{ display_date }}</strong>
     <div class="ds-month-year"><span>{{ display_month | upcase }}</span><span>{{ display_year }}</span></div>
    </div>
    <div class="ds-clock">{{ display_time }}</div>
    <div class="ds-period">{{ display_period }} · LOCAL TIME</div>
   </div>
   <div class="ds-left-footer">MAKE TODAY COUNT.</div>
  </section>
  <section class="ds-right">
   <div class="ds-right-header"><strong class="ds-heading">QUOTE OF THE DAY</strong><span>✦</span></div>
   <div class="ds-quote-area">
    <div class="ds-quote-mark">“</div>
    <div class="ds-quote">A little progress today adds up.</div>
    <div class="ds-author">— Daily Spark</div>
   </div>
   <div class="ds-right-footer"><span>ONE DAY. ONE THOUGHT.</span><span class="ds-credit">DAILY SPARK</span></div>
  </section>
 </div>
</div>
<div class="title_bar">
  <span class="title">Daily Spark</span>
  <span class="instance">itscryptune</span>
</div>