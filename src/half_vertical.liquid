<div class="layout">
 <div class="ds-compact ds-vertical">
  <div class="ds-compact-header"><strong>✦ DAILY SPARK</strong></div>
  <div class="ds-vertical-main">
   <strong class="ds-vertical-time">{{ display_time }}</strong>
   <div class="ds-vertical-date">{{ display_period }} · {{ display_day }}, {{ display_date }} {{ display_month }}</div>
   <div class="ds-vertical-line"></div>
   <div class="ds-vertical-quote {{ quote_class }}">“{{ quote_vertical | default: display_quote | escape }}”</div>
   <div class="ds-author">— {{ display_author | escape }}</div>
  </div>
  <div class="ds-compact-footer">
    <span class="ds-compact-credit">
      {% if quote_source == "zenquotes" %}zenquotes.io
      {% elsif quote_source == "custom" %}PERSONAL QUOTE
      {% else %}DAILY SPARK{% endif %}
    </span>
 </div>
</div>