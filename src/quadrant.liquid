<div class="layout">
 <div class="ds-compact ds-mini">
  <div class="ds-mini-header">✦ DAILY SPARK</div>
  <div class="ds-mini-date">{{ display_day | upcase }} · {{ display_time }} {{ display_period }}</div>
  <div class="ds-mini-quote {{ quote_class }}">“{{ quote_quadrant | default: display_quote | escape }}”</div>
  <div class="ds-mini-author">— {{ display_author | escape }}</div>
  <div class="ds-compact-footer">
    <span class="ds-compact-credit">
      {% if quote_source == "zenquotes" %}zenquotes.io
      {% elsif quote_source == "custom" %}PERSONAL QUOTE
      {% else %}DAILY SPARK{% endif %}
    </span>
 </div>
</div>